<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CRM Pro - Pollo Picante Carlitos</title>
  <style>
    :root{
      --bg:#f4f6f8;
      --card:#ffffff;
      --text:#2b2b2b;
      --muted:#6b7280;
      --border:#e5e7eb;

      --brand-red:#b22222;
      --brand-orange:#ff7a00;
      --brand-yellow:#ffc857;
      --brand-green:#1f8a4c;

      --shadow:0 8px 24px rgba(0,0,0,.08);
      --radius:14px;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Arial, Helvetica, sans-serif;
      color:var(--text);
      background:var(--bg);
    }

    .topbar{
      background: linear-gradient(90deg, var(--brand-red), var(--brand-orange));
      color:#fff;
      padding:18px 24px;
      box-shadow: var(--shadow);
      position: sticky;
      top:0;
      z-index:10;
    }
    .topbar h1{
      margin:0;
      font-size:22px;
    }
    .topbar p{
      margin:6px 0 0;
      opacity:.95;
      font-size:13px;
    }

    .layout{
      max-width:1200px;
      margin:22px auto;
      padding:0 16px;
      display:grid;
      grid-template-columns:320px 1fr;
      gap:16px;
    }

    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:var(--radius);
      box-shadow:var(--shadow);
    }

    .left{
      padding:18px;
      align-self:start;
      position: sticky;
      top:90px;
    }

    .photo-wrap{
      display:flex;
      justify-content:center;
      margin-top:6px;
      margin-bottom:14px;
    }
    .photo{
      width:165px;
      height:165px;
      border-radius:50%;
      object-fit:cover;
      border:5px solid var(--brand-red);
      box-shadow:0 6px 16px rgba(0,0,0,.15);
      background:#eee;
    }

    .chip{
      display:inline-block;
      font-size:12px;
      border-radius:999px;
      padding:4px 10px;
      border:1px solid;
      margin-top:6px;
    }
    .chip.ok{
      color:var(--brand-green);
      background:#eaf8ef;
      border-color:#bde5cb;
    }

    .section-title{
      margin:14px 0 10px;
      color:var(--brand-red);
      font-size:17px;
    }

    .field{
      margin-bottom:10px;
    }
    .field label{
      display:block;
      font-size:11px;
      text-transform:uppercase;
      letter-spacing:.4px;
      color:var(--muted);
      margin-bottom:2px;
    }
    .field div{
      font-size:14px;
      font-weight:600;
      line-height:1.35;
    }

    .right{
      display:grid;
      gap:16px;
    }

    .toolbar{
      padding:14px;
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      align-items:center;
      justify-content:space-between;
    }

    .search-wrap{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
      align-items:center;
      width:100%;
    }
    .search-wrap input{
      flex:1 1 320px;
      border:1px solid var(--border);
      border-radius:10px;
      padding:10px 12px;
      font-size:14px;
      outline:none;
    }
    .btn{
      border:none;
      border-radius:10px;
      padding:10px 12px;
      font-weight:700;
      cursor:pointer;
    }
    .btn.primary{
      background:var(--brand-red);
      color:white;
    }
    .btn.light{
      background:#f3f4f6;
      color:#111827;
    }

    .kpis{
      display:grid;
      grid-template-columns:repeat(4, minmax(160px, 1fr));
      gap:12px;
      padding:14px;
    }
    .kpi{
      border:1px solid var(--border);
      border-radius:12px;
      padding:12px;
      background:linear-gradient(180deg, #fff, #fff9f4);
    }
    .kpi .label{
      color:var(--muted);
      font-size:12px;
      margin-bottom:6px;
    }
    .kpi .value{
      font-size:22px;
      font-weight:800;
      color:#111827;
    }
    .kpi .sub{
      margin-top:4px;
      font-size:12px;
      color:var(--muted);
    }

    .orders{
      padding:14px;
    }
    .orders h3{
      margin:2px 0 12px;
      color:var(--brand-red);
    }

    details.order{
      border:1px solid var(--border);
      border-radius:12px;
      padding:10px 12px;
      margin-bottom:10px;
      background:#fff;
    }

    details.order[open]{
      border-color:#f3c5a8;
      background:#fffaf6;
    }

    summary{
      cursor:pointer;
      list-style:none;
      display:flex;
      justify-content:space-between;
      gap:10px;
      align-items:center;
      font-size:14px;
      font-weight:700;
    }
    summary::-webkit-details-marker{display:none}

    .order-meta{
      color:var(--muted);
      font-size:12px;
      font-weight:600;
    }

    .order-grid{
      margin-top:10px;
      display:grid;
      grid-template-columns:repeat(2,minmax(180px,1fr));
      gap:10px;
    }

    .mini{
      border:1px dashed var(--border);
      border-radius:10px;
      padding:8px;
      font-size:13px;
      background:#fff;
    }

    .tags{
      margin-top:6px;
      display:flex;
      flex-wrap:wrap;
      gap:6px;
    }

    .tag{
      font-size:11px;
      padding:4px 8px;
      border-radius:999px;
      background:#ffe9db;
      color:#7a2c00;
      border:1px solid #ffd4b7;
    }

    .empty{
      display:none;
      margin-top:10px;
      padding:12px;
      border:1px dashed #f0b38d;
      border-radius:10px;
      background:#fff4ec;
      color:#9a3412;
      font-size:13px;
    }

    .foot{
      text-align:center;
      color:#6b7280;
      font-size:12px;
      margin:6px 0 18px;
    }

    @media (max-width:980px){
      .layout{grid-template-columns:1fr}
      .left{position:static}
      .kpis{grid-template-columns:repeat(2, minmax(150px, 1fr))}
    }
    @media (max-width:560px){
      .kpis{grid-template-columns:1fr}
      .order-grid{grid-template-columns:1fr}
    }
  </style>
</head>
<body>
  <header class="topbar">
    <h1>CRM Comercial | Pollo Picante Carlitos</h1>
    <p>Vista de cliente • Perfil, KPIs y compras recientes</p>
  </header>

  <main class="layout">
    <!-- Panel izquierdo -->
    <aside class="card left">
      <div class="photo-wrap">
        <!-- Imagen de ejemplo tipo pasaporte -->
        <img class="photo" src="https://i.pravatar.cc/300?img=15" alt="Foto cliente tipo pasaporte">
      </div>

      <h2 class="section-title">Ficha del cliente</h2>

      <div class="field">
        <label>Nombre completo</label>
        <div>Teobaldo Prueba Inventada Gómez</div>
      </div>
      <div class="field">
        <label>Dirección</label>
        <div>Calle del Ají #909, Edif. Sazón Ficticio, San Aurelio</div>
      </div>
      <div class="field">
        <label>Teléfono</label>
        <div>+506 8700-5521</div>
      </div>
      <div class="field">
        <label>Correo</label>
        <div>teobaldo.no.real@correo-ficticio.demo</div>
      </div>
      <div class="field">
        <label>ID Cliente</label>
        <div>PPC-FAKE-00127-X</div>
      </div>
      <span class="chip ok">Cliente activo</span>
    </aside>

    <!-- Panel derecho -->
    <section class="right">
      <!-- Buscador -->
      <div class="card toolbar">
        <div class="search-wrap">
          <input id="searchInput" type="text" placeholder="Buscar por producto, especia o picante (ej: habanero, alitas, chipotle)">
          <button class="btn primary" id="btnBuscar">Buscar</button>
          <button class="btn light" id="btnLimpiar">Limpiar</button>
        </div>
      </div>

      <!-- KPIs -->
      <div class="card kpis">
        <div class="kpi">
          <div class="label">Total comprado (kg)</div>
          <div class="value" id="kpiTotalKg">0</div>
          <div class="sub">Acumulado del historial visible</div>
        </div>
        <div class="kpi">
          <div class="label">Ticket promedio (CRC)</div>
          <div class="value" id="kpiTicketProm">₡0</div>
          <div class="sub">Promedio por pedido visible</div>
        </div>
        <div class="kpi">
          <div class="label">Compra mayor</div>
          <div class="value" id="kpiMayorKg">0 kg</div>
          <div class="sub" id="kpiMayorProd">-</div>
        </div>
        <div class="kpi">
          <div class="label">Frecuencia estimada</div>
          <div class="value" id="kpiFrecuencia">0 días</div>
          <div class="sub">Promedio entre compras visibles</div>
        </div>
      </div>

      <!-- Historial plegable -->
      <div class="card orders">
        <h3>Historial de compras (plegable)</h3>

        <div id="ordersContainer"></div>
        <div class="empty" id="emptyState">No hay resultados con ese criterio de búsqueda.</div>
      </div>
    </section>
  </main>

  <p class="foot">Datos ficticios para demostración de interfaz CRM.</p>

  <script>
    // Base de datos ficticia
    const orders = [
      {
        fecha: "2026-11-01",
        producto: "Alitas de pollo crudo arreglado",
        kg: 3,
        precioCRC: 18500,
        picantes: ["Ají chombo", "Pimienta cayena"],
        especias: ["Ajo en polvo", "Páprika ahumada"],
        sucursal: "PPC - Sucursal Sabores del Centro",
        observaciones: "Corte para fritura rápida, marinado seco."
      },
      {
        fecha: "2026-10-28",
        producto: "Muslos de pollo crudo arreglado",
        kg: 5,
        precioCRC: 29400,
        picantes: ["Chile habanero"],
        especias: ["Comino", "Orégano seco", "Pimienta negra"],
        sucursal: "PPC - Sucursal Plaza del Carbón",
        observaciones: "Pedido para parrilla de fin de semana."
      },
      {
        fecha: "2026-10-24",
        producto: "Pechuga de pollo crudo arreglado",
        kg: 4,
        precioCRC: 26800,
        picantes: ["Chile de árbol"],
        especias: ["Mostaza en polvo", "Tomillo", "Ajo granulado"],
        sucursal: "PPC - Sucursal Barrio Picante",
        observaciones: "Preferencia de picor medio-alto."
      },
      {
        fecha: "2026-10-20",
        producto: "Contra muslo de pollo crudo arreglado",
        kg: 6,
        precioCRC: 33200,
        picantes: ["Chipotle molido"],
        especias: ["Páprika dulce", "Cebolla en polvo", "Laurel triturado"],
        sucursal: "PPC - Sucursal Ruta del Fuego",
        observaciones: "Preparación para horneado lento."
      },
      {
        fecha: "2026-10-17",
        producto: "Pollo entero troceado crudo arreglado",
        kg: 8,
        precioCRC: 44100,
        picantes: ["Jalapeño seco", "Curry picante"],
        especias: ["Romero", "Pimienta blanca"],
        sucursal: "PPC - Sucursal Mercado Norte",
        observaciones: "Cliente pidió mezcla especial de especias."
      }
    ];

    const container = document.getElementById("ordersContainer");
    const emptyState = document.getElementById("emptyState");
    const searchInput = document.getElementById("searchInput");
    const btnBuscar = document.getElementById("btnBuscar");
    const btnLimpiar = document.getElementById("btnLimpiar");

    function formatCRC(value){
      return "₡" + value.toLocaleString("es-CR");
    }

    function formatDate(iso){
      const [y,m,d] = iso.split("-");
      return `${d}/${m}/${y}`;
    }

    function daysBetween(a, b){
      const d1 = new Date(a + "T00:00:00");
      const d2 = new Date(b + "T00:00:00");
      const ms = Math.abs(d2 - d1);
      return Math.round(ms / (1000*60*60*24));
    }

    function renderOrders(list){
      container.innerHTML = "";

      if(!list.length){
        emptyState.style.display = "block";
      }else{
        emptyState.style.display = "none";
      }

      list.forEach((o, index) => {
        const details = document.createElement("details");
        details.className = "order";
        if(index === 0) details.open = true;

        details.innerHTML = `
          <summary>
            <span>${formatDate(o.fecha)} • ${o.producto}</span>
            <span class="order-meta">${o.kg} kg • ${formatCRC(o.precioCRC)}</span>
          </summary>
          <div class="order-grid">
            <div class="mini">
              <strong>Sucursal</strong><br>
              ${o.sucursal}
            </div>
            <div class="mini">
              <strong>Observaciones</strong><br>
              ${o.observaciones}
            </div>
            <div class="mini">
              <strong>Picantes</strong>
              <div class="tags">${o.picantes.map(p => `<span class="tag">${p}</span>`).join("")}</div>
            </div>
            <div class="mini">
              <strong>Especias</strong>
              <div class="tags">${o.especias.map(e => `<span class="tag">${e}</span>`).join("")}</div>
            </div>
          </div>
        `;
        container.appendChild(details);
      });

      updateKpis(list);
    }

    function updateKpis(list){
      const totalKg = list.reduce((acc,o)=>acc + o.kg, 0);
      const totalCRC = list.reduce((acc,o)=>acc + o.precioCRC, 0);
      const ticketProm = list.length ? Math.round(totalCRC / list.length) : 0;

      let mayor = null;
      list.forEach(o => {
        if(!mayor || o.kg > mayor.kg) mayor = o;
      });

      // frecuencia promedio en días (con lista ordenada por fecha descendente)
      let freq = 0;
      if(list.length > 1){
        const ordered = [...list].sort((a,b)=> b.fecha.localeCompare(a.fecha));
        let sum = 0;
        for(let i=0;i<ordered.length-1;i++){
          sum += daysBetween(ordered[i].fecha, ordered[i+1].fecha);
        }
        freq = Math.round(sum / (ordered.length - 1));
      }

      document.getElementById("kpiTotalKg").textContent = totalKg.toLocaleString("es-CR");
      document.getElementById("kpiTicketProm").textContent = formatCRC(ticketProm);
      document.getElementById("kpiMayorKg").textContent = mayor ? `${mayor.kg} kg` : "0 kg";
      document.getElementById("kpiMayorProd").textContent = mayor ? mayor.producto : "-";
      document.getElementById("kpiFrecuencia").textContent = `${freq} días`;
    }

    function applyFilter(){
      const q = searchInput.value.trim().toLowerCase();
      if(!q){
        renderOrders(orders);
        return;
      }

      const filtered = orders.filter(o => {
        const haystack = [
          o.fecha, o.producto, o.sucursal, o.observaciones,
          ...o.picantes, ...o.especias
        ].join(" ").toLowerCase();

        return haystack.includes(q);
      });

      renderOrders(filtered);
    }

    btnBuscar.addEventListener("click", applyFilter);
    btnLimpiar.addEventListener("click", () => {
      searchInput.value = "";
      renderOrders(orders);
      searchInput.focus();
    });
    searchInput.addEventListener("keydown", (e)=>{
      if(e.key === "Enter") applyFilter();
    });

    // Render inicial
    renderOrders(orders);
  </script>
</body>
</html>
